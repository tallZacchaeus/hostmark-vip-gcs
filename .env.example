# Copy to .env.local and replace every "change-me" value. Never commit .env.local.
# Generate secrets with: openssl rand -base64 32

# --- Postgres container (compose.dev.yml) ---
# Use URL-safe values (openssl rand -hex 32): they are embedded in connection URLs below.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
SERVICE_DB_PASSWORD=change-me

# --- Database connections ---
# Runtime connection used by the API. Logs in as vip_app, so row-level security applies.
DATABASE_URL=postgres://vip_app:change-me@127.0.0.1:5433/vip_gcs
# Trusted server work (Better Auth's own queries, scripts). The only login that can act as vip_system.
SERVICE_DATABASE_URL=postgres://vip_service:change-me@127.0.0.1:5433/vip_gcs
# Real-time LISTEN connection. Leave empty to use DATABASE_URL. On Supabase, DATABASE_URL uses the
# transaction pooler (port 6543), which cannot LISTEN: point this at the session pooler (5432).
DATABASE_LISTEN_URL=
# Owner connection used only by migrations (dbmate) and type generation (kysely-codegen).
DATABASE_MIGRATION_URL=postgres://vip_owner:change-me@127.0.0.1:5433/vip_gcs?sslmode=disable
# Database used by `pnpm test:db` and `pnpm test:integration`. It is dropped and recreated on every run.
DATABASE_TEST_NAME=vip_gcs_test

# --- Better Auth ---
# At least 32 random characters. Changing it signs everyone out.
BETTER_AUTH_SECRET=change-me
# Public base URL of this app (scheme + host + port).
BETTER_AUTH_URL=http://localhost:3000

# --- API ---
# Allowed browser origins when the frontend is hosted separately (e.g. a Figma Make export).
# Comma-separated, e.g. https://ops.example.com. Leave empty for same-origin only.
API_ALLOWED_ORIGINS=

# --- Optional integrations (unset = offline stand-ins, no external calls) ---
# Claude reads free text on registrations and pasted messages. Unset: offline rules instead.
ANTHROPIC_API_KEY=
# INTAKE_AI_MODEL=claude-opus-5-5
# Cloudflare Turnstile on the public registration form. Unset: rate limits only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# AeroDataBox (RapidAPI) live flight status, used when the event is in live mode. Unset: no polling.
AERODATABOX_API_KEY=
# Live flight-status calls allowed per day; coordinators are warned at 80%.
FLIGHT_POLL_DAILY_LIMIT=160

# --- Background worker (flight checks, simulation steps, driver suggestions) ---
# in-process: the app server runs it. off: run `pnpm worker` as its own process instead, or (Vercel)
# let a scheduler call GET /api/internal/worker-tick (docs/02-TRD.md §5.2).
WORKER_MODE=in-process
# Bearer secret the scheduler sends to /api/internal/worker-tick (at least 32 characters).
# Unset: that route does not exist.
CRON_SECRET=
# Where "Request a demo" on the landing page is emailed (needs RESEND_API_KEY and MAIL_FROM).
# Unset: the form says demo requests are not open yet.
DEMO_REQUEST_TO=
