{
  "name": "vip-gcs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hostmark VIP Guest Coordination System: Next.js web app, API and database",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:ui": "vitest run --project ui",
    "test:db": "vitest run --project db",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "local:setup": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/local-setup.ts",
    "db:up": "docker compose --env-file .env.local -f compose.dev.yml up -d --wait",
    "db:down": "docker compose --env-file .env.local -f compose.dev.yml down",
    "db:migrate": "dbmate --env-file .env.local -e DATABASE_MIGRATION_URL --no-dump-schema up",
    "db:rollback": "dbmate --env-file .env.local -e DATABASE_MIGRATION_URL --no-dump-schema rollback",
    "db:new": "dbmate new",
    "db:types": "node scripts/generate-db-types.ts",
    "db:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed-dev.ts",
    "admin:create": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/create-super-admin.ts",
    "hosted:migrate": "dbmate --env-file .env.deploy.local -e DBMATE_URL --no-dump-schema --wait up",
    "hosted:seed": "node --conditions=react-server --env-file=.env.deploy.local --import tsx scripts/seed-dev.ts",
    "hosted:admin": "node --conditions=react-server --env-file=.env.deploy.local --import tsx scripts/create-super-admin.ts",
    "worker": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx worker/index.ts",
    "eval:build": "node --import tsx eval/build-intake-dataset.ts",
    "eval:intake": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx eval/run-intake.ts",
    "eval:cascade": "node --conditions=react-server --import tsx eval/run-cascade.ts",
    "eval:allocation": "node --import tsx eval/run-allocation.ts",
    "eval:cleaning": "node --conditions=react-server --import tsx eval/run-cleaning.ts",
    "eval:copilot": "node --conditions=react-server --import tsx eval/run-copilot.ts",
    "eval:all": "node --import tsx eval/run-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@vercel/functions": "3.9.11",
    "better-auth": "1.7.7",
    "csv-parse": "7.0.3",
    "kysely": "0.29.6",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "swr": "2.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "5.0.4",
    "dbmate": "2.36.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "kysely-codegen": "0.20.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.0.0",
    "vitest": "5.0.4"
  }
}
